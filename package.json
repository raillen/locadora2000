{
  "name": "locadora2000-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "catalog": "node scripts/import-catalog.mjs",
    "register": "node scripts/register-asset.mjs",
    "check": "node scripts/check-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "build": "npm run catalog && npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "dompurify": "3.3.3",
    "marked": "17.0.1",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "vite": "7.3.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
